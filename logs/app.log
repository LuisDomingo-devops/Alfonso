c035-EMAIL_CAMPAIGN_2026_07_17_Microsoft_IA_Summer&utm_medium=email&utm_term=0_-8c854eeaf7-505662109)\r\n\r\nAB-730 15:00 – 20:00\r\nNivel intermedio\r\n\r\nTransformación de procesos de negocio con IA generativa (https://cas-training.com/eventos/ab-730-transformacion-de-procesos-de-negocio-con-ia-generativa/?utm_source=CAS+Training&utm_campaign=7ff665c035-EMAIL_CAMPAIGN_2026_07_17_Microsoft_IA_Summer&utm_medium=email&utm_term=0_-8c854eeaf7-505662109)\r\n\r\nIdentifica procesos mejorables, automatiza tareas y diseña flujos inteligentes dentro del ecosistema Microsoft 365.\r\nRegistrarme gratis → (https://cas-training.com/eventos/ab-730-transformacion-de-procesos-de-negocio-con-ia-generativa/?utm_source=CAS+Training&utm_campaign=7ff665c035-EMAIL_CAMPAIGN_2026_07_17_Microsoft_IA_Summer&utm_medium=email&utm_term=0_-8c854eeaf7-505662109)\r\n\r\nMiércoles 22 de julio\r\n\r\nAB-731 9:00 – 15:00\r\nNivel intermedio\r\n\r\nImpulsa la transformación de tu organización mediante IA (https://cas-training.com/eventos/ab-731-impulsa-la-transformacion-de-tu-organizacion-mediante-ia/?utm_source=CAS+Training&utm_campaign=7ff665c035-EMAIL_CAMPAIGN_2026_07_17_Microsoft_IA_Summer&utm_medium=email&utm_term=0_-8c854eeaf7-505662109)\r\n\r\nEstrategia de adopción, hoja de ruta, gestión del cambio y gobierno responsable de la IA.\r\nRegistrarme gratis → (https://cas-training.com/eventos/ab-731-impulsa-la-transformacion-de-tu-organizacion-mediante-ia/?utm_source=CAS+Training&utm_campaign=7ff665c035-EMAIL_CAMPAIGN_2026_07_17_Microsoft_IA_Summer&utm_medium=email&utm_term=0_-8c854eeaf7-505662109)\r\n\r\nAI-3026 15:00 – 20:00\r\nNivel intermedio\r\n\r\nDesarrollo de agentes de IA en Azure (https://cas-training.com/eventos/ai-3026-desarrollo-de-agentes-de-ia-en-azure/?utm_source=CAS+Training&utm_campaign=7ff665c035-EMAIL_CAMPAIGN_2026_07_17_Microsoft_IA_Summer&utm_medium=email&utm_term=0_-8c854eeaf7-505662109)\r\n\r\nAgentes capaces de razonar, planificar y ejecutar tareas de forma autónoma sobre Azure AI Services.\r\nRegistrarme gratis → (https://cas-training.com/eventos/ai-3026-desarrollo-de-agentes-de-ia-en-azure/?utm_source=CAS+Training&utm_campaign=7ff665c035-EMAIL_CAMPAIGN_2026_07_17_Microsoft_IA_Summer&utm_medium=email&utm_term=0_-8c854eeaf7-505662109)\r\n\r\nPuedes registrarte a una o a todas las sesiones.\r\n\r\nPlazas limitadas  ·  Virtual en directo  ·  Cursos oficiales Microsoft\r\n\r\nhttps://cas-training.com?utm_source=CAS+Training&utm_campaign=7ff665c035-EMAIL_CAMPAIGN_2026_07_17_Microsoft_IA_Summer&utm_medium=email&utm_term=0_-8c854eeaf7-505662109 Microsoft Solutions Partner\r\nEventos (https://cas-training.com/eventos/?utm_source=CAS+Training&utm_campaign=7ff665c035-EMAIL_CAMPAIGN_2026_07_17_Microsoft_IA_Summer&utm_medium=email&utm_term=0_-8c854eeaf7-505662109) Catálogo (https://cas-training.com/catalogo-formativo/?utm_source=CAS+Training&utm_campaign=7ff665c035-EMAIL_CAMPAIGN_2026_07_17_Microsoft_IA_Summer&utm_medium=email&utm_term=0_-8c854eeaf7-505662109) Contacto (https://cas-training.com/contacto/?utm_source=CAS+Training&utm_campaign=7ff665c035-EMAIL_CAMPAIGN_2026_07_17_Microsoft_IA_Summer&utm_medium=email&utm_term=0_-8c854eeaf7-505662109)\r\n\r\nMadrid · Barcelona · cas-training.com\r\nhttps://linkedin.com/?utm_source=CAS+Training&utm_campaign=7ff665c035-EMAIL_CAMPAIGN_2026_07_17_Microsoft_IA_Summer&utm_medium=email&utm_term=0_-8c854eeaf7-505662109\r\nhttps://instagram.com/?utm_source=CAS+Training&utm_campaign=7ff665c035-EMAIL_CAMPAIGN_2026_07_17_Microsoft_IA_Summer&utm_medium=email&utm_term=0_-8c854eeaf7-505662109\r\n\r\nCopyright (C) 2026 CAS Training. Todos los derechos reservados.\r\nHas recibido este correo porque te has suscrito en nuestro sitio web.\r\nActualizar tus preferencias (https://cas-training.us19.list-manage.com/profile?u=e49bc16594e4f0982c914e97a&id=cfa843343d&e=99f81999f4&c=7ff665c035) | Cancelar la suscripción (https://cas-training.us19.list-manage.com/unsubscribe?u=e49bc16594e4f0982c914e97a&id=cfa843343d&t=b&e=99f8