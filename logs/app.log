```python
import tkinter as tk

def main():
    root = tk.Tk()
    # Configuración inicial de la ventana principal
    root.title("Alfonso - Asistente Personal de IA")
    root.geometry("800x600")

    # Crear un widget para mostrar el título
    label = tk.Label(root, text="Bienvenido a Alfonso - Asistente Personal de IA", font=("Arial", 14))
    label.pack(pady=20)

    # Ejecutar la ventana principal
    root.mainloop()

if __name__ == '__main__':
    main()
