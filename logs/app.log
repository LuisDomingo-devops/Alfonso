yle="width: 100% !important;">\r\n\t\t            <tr>\r\n                        <td style="width: 100% !important">\r\n                            <v:image id=\'logoImg\' style=\'width:85pt;height:45pt\' src="https://www.home.saxo/-/media/digital-engagement/Mobius/header-logos/HeaderLogo_round_209x108" />\r\n                        </td>\r\n                    </tr>\r\n                </table>\r\n            </td>\r\n        </v:textbox>\r\n        </v:fill>\r\n        </v:rect>\r\n\t<![endif]-->\r\n\r\n    <!--[if !mso]-->\r\n    <td class="header" style="width: 100% !important; background-color: #051478; background: linear-gradient(#051478, #051478) !important; border-radius: 6px; margin-top: 20px; padding: 7px; font-family: Inter, sans-serif !important;">\r\n\t\t<table class="contenttable">\r\n            <tr>\r\n            <td >\r\n\t\t\t    <img id="logoImg" style="width: 100px !important;" src="https://www.home.saxo/-/media/digital-engagement/Mobius/header-logos/HeaderLogo_round_209x108" />\r\n  \t        </td>\r\n            </tr>\r\n        </table>\r\n\t</td>\r\n    <!--[endif]-->\r\n    </tr>\r\n    </table>\r\n    <!--end headertable-->\r\n\r\n<table class="contenttable" border="0" cellspacing="0" cellpadding="0" style="width: 100% !important">\r\n    <tr>\r\n    \r\n        <td class="white-inner-cont darkmode" bgcolor="#ffffff" style="width: 100%; border-radius: 8px !important; border: 1px solid #e5e5e5; font-family: Inter, sans-serif !important; padding: 25px;">\r\n    \r\n\r\n\r\n\r\n    \r\n        \r\n    \r\n\r\n\r\n     \r\n\r\n    \r\n        <h2 style=\'text-align: left; font-family: Inter, sans-serif !important; font-style: normal; font-weight: normal; color: #141A27; line-height: 38px; font-size: 32px;\'>Important information regarding your Saxo account</h2>\r\n    \r\n\r\n    \r\n\r\n    \r\n\r\n    \r\n    \r\n    \r\n    \r\n    \r\n\r\n<!--\r\nname     = { Full | Given | Family | Generic | null }\r\nclient   = { FullName | GivenName | FamilyName }\r\ngreeting = { Dear | Kære | ... }\r\n\r\nDon\'t put HTML comments inside \'capture\' statements, possible unexpected behaviour.\r\n-->\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<p style=\'font-family: Inter, sans-serif !important; line-height: 24px !important; color: #141A27;\'>\r\n    \r\n        \r\n                Dear LUIS JOSE DOMINGO GARCIA DE LA INFANTA,\r\n                \r\n        \r\n    \r\n</p>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n    \r\n        \r\n    \r\n\r\n\r\n\r\n   <p style=\'text-align: left; font-family: Inter, sans-serif !important; line-height: 24px !important; color: #141A27;\' >This is a notification containing important information regarding your Saxo\xa0account 17159259.</p>\r\n\r\n\r\n\r\n\r\n\r\n<!-- NetPositionDepreciation -->\r\n\r\n\r\n<!-- Managed Portfolio / SaxoSelect -->\r\n\r\n\r\n<!-- Portfolio Report Reminder -->\r\n\r\n     \r\n    \r\n    \r\n        \r\n    \r\n\r\n\r\n\r\n   <p style=\'text-align: left; font-family: Inter, sans-serif !important; line-height: 24px !important; color: #141A27;\' >It has been some time since you looked at your Portfolio Report - please review it on a regular basis. <br><br> The Portfolio Report can be found under: My Profile > Account activity and reports > <b>Account reports</b> > Download report > Portfolio report <br><br> Under MiFID II we are obliged to remind you to check this report at regular intervals.</p>\r\n\r\n\r\n\r\n\r\n\r\n\r\n<!-- CTA. Logic in fragment will append URL with /Monitor, if client is POA. For specific partners, the link will change from Saxo Platform to Partner branded platform. -->\r\n\r\n    \r\n\r\n\r\n<!-- Assign the CTA text depending on the 3 different types of MiFID alerts -->\r\n\r\n\r\n\r\n\r\n\r\n\t\r\n\r\n\r\n<!-- Assign the URL depending on the owner ID -->\r\n\r\n        \r\n\r\n\r\n<!-- if client is POA, append the url with /Monitor -->\r\n\r\n\r\n<!-- specific cases -->\r\n\r\n\r\n<!-- define align, primaryBtnUrl, primaryBtnText, secondaryBtnUrl, s