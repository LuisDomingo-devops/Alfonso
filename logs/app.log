br/>\r\nPhilip Heymans Alle 15<br/>\r\n2900 Hellerup, Denmark</b>\r\n\t\t</div>\r\n\r\n\t\t\r\n\t\t<br>\r\n\t\t\r\n\r\n\t\t\r\n\r\n\r\n\r\n    \r\n\r\n\r\n\r\n\r\n\r\n    <!-- AS entity - fallback language: en -->\r\n    <div class="footerlinks-cont " style=\'text-align: left;\' >\r\n        <a href="https://www.home.saxo/legal/copyright/saxo-copyright" class="footerlink" >\r\n            Copyright\r\n        </a>\r\n        \r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n<span class="footerlink">&#x2022; </span>\r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n\r\n        <a href="https://www.home.saxo/legal/disclaimer/saxo-disclaimer" class="footerlink" >\r\n            Disclaimer\r\n        </a>\r\n        \r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n<span class="footerlink">&#x2022; </span>\r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n\r\n        <a href="https://www.home.saxo/legal/risk-warning/saxo-risk-warning" class="footerlink" >\r\n            Risk Warning\r\n        </a>\r\n        \r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n<span class="footerlink">&#x2022; </span>\r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n\r\n        <a href="https://www.home.saxo/legal/privacy-policy/saxo-privacy-policy" class="footerlink" >\r\n            Privacy Policy\r\n        </a>\r\n        \r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n<span class="footerlink">&#x2022; </span>\r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n\r\n        <a href="https://www.help.saxo/hc/en-us" class="footerlink" >\r\n            Support\r\n        </a>\r\n        \r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n<span class="footerlink">&#x2022; </span>\r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n\r\n        <a href="https://www.home.saxo/contact-us" class="footerlink" >\r\n            Contact Us\r\n        </a>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\t\t<!-- CFD PERCENTAGE / ESMA DISCLAIMER -- UPDATED QUARTERLY, SEE WIKI: https://wiki/pages/viewpage.action?pageId=325685073 -->\r\n<!-- calculates the logic for what th