n\r\n    \r\n\r\n\r\n\r\n\r\n\r\n    <!-- AS entity - fallback language: en -->\r\n    <div class="footerlinks-cont " style=\'text-align: left;\' >\r\n        <a href="https://www.home.saxo/legal/copyright/saxo-copyright" class="footerlink" >\r\n            Copyright\r\n        </a>\r\n        \r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n<span class="footerlink">&#x2022; </span>\r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n\r\n        <a href="https://www.home.saxo/legal/disclaimer/saxo-disclaimer" class="footerlink" >\r\n            Disclaimer\r\n        </a>\r\n        \r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n<span class="footerlink">&#x2022; </span>\r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n\r\n        <a href="https://www.home.saxo/legal/risk-warning/saxo-risk-warning" class="footerlink" >\r\n            Risk Warning\r\n        </a>\r\n        \r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n<span class="footerlink">&#x2022; </span>\r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n\r\n        <a href="https://www.home.saxo/legal/privacy-policy/saxo-privacy-policy" class="footerlink" >\r\n            Privacy Policy\r\n        </a>\r\n        \r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n<span class="footerlink">&#x2022; </span>\r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n\r\n        <a href="https://www.help.saxo/hc/en-us" class="footerlink" >\r\n            Support\r\n        </a>\r\n        \r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n<span class="footerlink">&#x2022; </span>\r\n<!--[if gte mso 9]>&nbsp;<![endif]-->\r\n\r\n        <a href="https://www.home.saxo/contact-us" class="footerlink" >\r\n            Contact Us\r\n        </a>\r\n    </div>\r\n\r\n\r\n\r\n\r\n\t\t<!-- CFD PERCENTAGE / ESMA DISCLAIMER -- UPDATED QUARTERLY, SEE WIKI: https://wiki/pages/viewpage.action?pageId=325685073 -->\r\n<!-- calculates the logic for what the CFD Percentage should be for each legal entity. This fragment is called inside the footer, which then assigns it to the translation -->\r\n\r\n\r\n\r\n        \r\n        \r\n    \r\n\r\n\t\t\r\n\r\n\r\n\t\t\r\n\r\n\r\n\r\n    \r\n\r\n\r\n\t\t\r\n\t\t\r\n\t\t    <p style="font-size: 10px; text-align: left">\r\n\t\t\r\n\t\t\r\n\t\t\tThis email constitutes a legal notification from Saxo Bank A/S containing important information that may have significant impact on your account and/or activities with Saxo Bank. Please note that it is not possible to unsubscribe from legal notifications. <br><br> The value of your investments can go down as well as up. Losses can exceed deposits on margin products. Complex products, including CFDs and FX, come with a high risk of losing money rapidly due to leverage. <b>64% of retail investor accounts lose money when trading CFDs with this provider. </b>You should consider whether you understand how CFDs, FX or any of our other products work and whether you can afford to take the high risk of losing your money.\r\n\r\n\t\t</p>\r\n\t\t\r\n\t\t\r\n\t\r\n    </td></tr></table><!--end footer-->\r\n  </td></tr></table><!-- end maintable -->\r\n</body>\r\n</html>\r\n\r\n', 'received_at': '2026-07-17 06:01', 'category': 'empleo', 'importance': 'Media', 'read_status': 0, 'summary': 'Propuesta u oportunidad profesional de empleo en el sector tecnológico.', 'created_at': '2026-07-17 07:32:58', 'processed_for_calendar': 1}, {'id': 105, 'sender': 'Alerta de empleo InfoJobs <ofertas@push.infojobs.net>', 'recipient': 'luisdomingogarcia79@gmail.com', 'subject': '5 ofertas de empleo en Madrid', 'body': '<!DOCTYPE html><html xmlns="http://www.w3.org/1999/xhtml" xml:lang="es" lang="es"><head><title>InfoJobs</title> <meta content="text/html; charset=utf-8" http-equiv=Content-Type> <meta name="viewport" content="width=device-width"/> <style type="text/css">html{margin: 0; padding: 0;}a, a:link, a:visited{text-decoration: none;}body{-webkit-font-smoothing: antialiased !important; -moz-osx-font-smoothing: grayscale !important; -webkit-text-size-adjust: none !important; height: 100% !impor